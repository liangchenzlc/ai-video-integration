{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/DraftPayload",
  "$defs": {
    "DraftPayload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "story"
            },
            "content": {
              "$ref": "#/$defs/DraftEditableStoryPayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "asset"
            },
            "content": {
              "$ref": "#/$defs/DraftEditableAssetPayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "shot"
            },
            "content": {
              "$ref": "#/$defs/DraftEditableShotPayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "speech"
            },
            "content": {
              "$ref": "#/$defs/DraftEditableSpeechPayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "subtitle"
            },
            "content": {
              "$ref": "#/$defs/DraftEditableSubtitlePayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "timeline"
            },
            "content": {
              "$ref": "#/$defs/DraftEditableTimelinePayload"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "content"
          ],
          "properties": {
            "kind": {
              "const": "observation"
            },
            "content": {
              "$ref": "#/$defs/DraftEditableObservationPayload"
            }
          }
        }
      ]
    },
    "DraftEditableStoryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "sourceText": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100000
        },
        "sourceHash": {
          "$ref": "#/$defs/Hash"
        },
        "inputType": {
          "type": "string",
          "enum": [
            "idea",
            "excerpt",
            "script"
          ]
        },
        "approvalLevel": {
          "type": "string",
          "enum": [
            "proposal",
            "outline",
            "scenes",
            "dialogue"
          ]
        },
        "brief": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        },
        "outline": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4000
          },
          "minItems": 0,
          "maxItems": 100
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditableRequirement"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditableScene"
          },
          "minItems": 0,
          "maxItems": 200
        },
        "dialogues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditableDialogue"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "adaptationNotes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4000
          },
          "minItems": 0,
          "maxItems": 200
        }
      }
    },
    "Hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "DraftEditableRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "category": {
          "type": "string",
          "enum": [
            "fact",
            "action",
            "dialogue",
            "sound",
            "screenText",
            "reveal"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DraftEditableSourceSpan"
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "decision": {
          "type": "string",
          "enum": [
            "keep",
            "omit",
            "replace",
            "unresolved"
          ]
        },
        "decisionReason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        }
      }
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "DraftEditableSourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "sourceHash": {
          "$ref": "#/$defs/Hash"
        },
        "startCodePoint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endCodePoint": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "DraftEditableScene": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "title": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "action": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10000
        },
        "plannedMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "locationAssetId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DraftEditableDialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "speakerAssetId": {
          "$ref": "#/$defs/Uuid"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "delivery": {
          "type": "string",
          "enum": [
            "visible",
            "VO",
            "OS"
          ]
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "sceneId": {
          "$ref": "#/$defs/Uuid"
        }
      }
    },
    "DraftEditableAssetPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "assetType": {
          "type": "string",
          "enum": [
            "character",
            "location",
            "prop",
            "style"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "identityAnchors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 50
        },
        "allowedChanges": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 50
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditablePersistentState"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditableReference"
          },
          "minItems": 0,
          "maxItems": 16
        }
      }
    },
    "DraftEditablePersistentState": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "description": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "reason": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "fromShotId": {
          "$ref": "#/$defs/Uuid"
        },
        "throughShotId": {
          "$ref": "#/$defs/Uuid"
        }
      }
    },
    "DraftEditableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "mediaId": {
          "$ref": "#/$defs/Uuid"
        },
        "mediaHash": {
          "$ref": "#/$defs/Hash"
        },
        "role": {
          "type": "string",
          "enum": [
            "identity",
            "style",
            "location",
            "prop",
            "composition",
            "firstFrame",
            "keyMoment",
            "endFrame",
            "voiceDrive",
            "voiceReference"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "state": {
          "type": "string",
          "enum": [
            "pending",
            "imported",
            "verified",
            "missing",
            "incompatible"
          ]
        },
        "keep": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "ignore": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "crop": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "x": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "y": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "DraftEditableShotPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "shotId": {
          "$ref": "#/$defs/Uuid"
        },
        "purpose": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "sceneId": {
          "$ref": "#/$defs/Uuid"
        },
        "assetRevisionIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "minItems": 0,
          "maxItems": 30
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "startState": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditableEvent"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "endState": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "camera": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "subjectHand": {
          "type": "string",
          "enum": [
            "left",
            "right",
            "both",
            "none"
          ]
        },
        "plannedMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "dialogueIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "minItems": 0,
          "maxItems": 50
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditableReference"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "videoMediaId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "pickupOfShotId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "use": {
          "type": "string",
          "enum": [
            "original",
            "supplement",
            "alternate"
          ]
        }
      }
    },
    "DraftEditableEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "time": {
          "$ref": "#/$defs/DraftEditableTimeRange"
        },
        "requirementIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "carrier": {
          "type": "string",
          "enum": [
            "visual",
            "audio",
            "subtitle",
            "screenText"
          ]
        },
        "observer": {
          "type": "string",
          "enum": [
            "physical",
            "character",
            "audience"
          ]
        }
      }
    },
    "DraftEditableTimeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "DraftEditableSpeechPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "dialogueId": {
          "$ref": "#/$defs/Uuid"
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        },
        "speakerAssetId": {
          "$ref": "#/$defs/Uuid"
        },
        "mediaId": {
          "$ref": "#/$defs/Uuid"
        },
        "measuredMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "voicedRanges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditableTimeRange"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "timingMethod": {
          "type": "string",
          "enum": [
            "manual",
            "provider_sentence",
            "provider_word",
            "estimated"
          ]
        },
        "voicePreset": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "pronunciationNotes": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2000
        }
      }
    },
    "DraftEditableSubtitlePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "audioRevisionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "timingMethod": {
          "type": "string",
          "enum": [
            "manual",
            "provider_sentence",
            "provider_word",
            "estimated"
          ]
        },
        "cues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditableCue"
          },
          "minItems": 0,
          "maxItems": 2000
        }
      }
    },
    "DraftEditableCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "dialogueId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500
        },
        "time": {
          "$ref": "#/$defs/DraftEditableTimeRange"
        },
        "differsFromDialogue": {
          "type": "boolean"
        }
      }
    },
    "DraftEditableTimelinePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "width": {
          "enum": [
            720,
            1080,
            1280,
            1920
          ]
        },
        "height": {
          "enum": [
            720,
            1080,
            1280,
            1920
          ]
        },
        "fps": {
          "$ref": "#/$defs/DraftEditableFps"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditableTrack"
          },
          "minItems": 0,
          "maxItems": 100
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditableClip"
          },
          "minItems": 0,
          "maxItems": 5000
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditableTransition"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "burnSubtitles": {
          "type": "boolean"
        }
      }
    },
    "DraftEditableFps": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "numerator": {
          "enum": [
            24,
            25,
            30
          ]
        },
        "denominator": {
          "const": 1
        }
      }
    },
    "DraftEditableTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "kind": {
          "type": "string",
          "enum": [
            "image",
            "video",
            "voice",
            "music",
            "sfx",
            "subtitle"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "muted": {
          "type": "boolean"
        }
      }
    },
    "DraftEditableClip": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "trackId": {
          "$ref": "#/$defs/Uuid"
        },
        "shotId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "mediaId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "contentRevisionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "startMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "durationMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "gainDb": {
          "type": "number",
          "minimum": -96,
          "maximum": 12
        },
        "linkedClipIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          },
          "minItems": 0,
          "maxItems": 1000
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DraftEditableKeyframe"
          },
          "minItems": 0,
          "maxItems": 1000
        }
      }
    },
    "DraftEditableKeyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "timeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "property": {
          "type": "string",
          "enum": [
            "x",
            "y",
            "scale",
            "opacity",
            "volume"
          ]
        },
        "value": {
          "type": "number",
          "minimum": -10000,
          "maximum": 10000
        },
        "interpolation": {
          "type": "string",
          "enum": [
            "linear",
            "hold"
          ]
        }
      }
    },
    "DraftEditableTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "id": {
          "$ref": "#/$defs/Uuid"
        },
        "fromClipId": {
          "$ref": "#/$defs/Uuid"
        },
        "toClipId": {
          "$ref": "#/$defs/Uuid"
        },
        "type": {
          "type": "string",
          "enum": [
            "cut",
            "dissolve",
            "fade"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    },
    "DraftEditableObservationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "mediaId": {
          "$ref": "#/$defs/Uuid"
        },
        "mediaHash": {
          "$ref": "#/$defs/Hash"
        },
