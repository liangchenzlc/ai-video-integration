{
  "name": "ai-video-integration",
  "version": "0.1.0",
  "private": true,
  "description": "Windows local AI video creation workspace",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pack:win": "electron-builder --dir --win --x64",
    "api:generate": "openapi-typescript ../contracts/openapi.json -o src/api/runtime-types.ts",
    "format": "prettier --write .",
    "lint": "eslint . && prettier --check ."
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "electron": "44.3.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "electron-vite": "5.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron-builder": "26.15.3",
    "openapi-typescript": "7.13.0",
    "vitest": "5.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "typescript-eslint": "8.70.0",
    "prettier": "3.9.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
