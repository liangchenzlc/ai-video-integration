{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "electron/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "electron.vite.config.ts"
  ]
}
